  <diagram id="diagram_b2b" name="B2B Рассылка КП ЧЗМ">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1360" math="0" shadow="0">
      <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="2" value="&lt;b&gt;B2B-РАССЫЛКА КОММЕРЧЕСКОГО ПРЕДЛОЖЕНИЯ: СТЕЛЛАЖ ДЛЯ ЛИСТОВОГО МЕТАЛЛА 6000×2000 мм&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:12px;font-weight:normal;color:#37474f;&#x27;&gt;Производитель: Чайковский завод «Механика» (ЧЗМ, модель 16112.200) | Автоматизация рассылки через корпоративный Яндекс 360 (SMTP)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8f9fa;strokeColor=#b0bec5;strokeWidth=1.5;fontSize=15;fontColor=#212121;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1680" height="65" as="geometry"/></mxCell>
    <mxCell id="3" value="&lt;b&gt;🏭 Продукт ЧЗМ:&lt;/b&gt; Стеллаж 16112.200 (5 платформ, до 25 т, выкат 100%, 6000×2000 мм)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e8f5e9;strokeColor=#4caf50;strokeWidth=1.2;fontSize=11;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="410" height="36" as="geometry"/></mxCell>
    <mxCell id="4" value="&lt;b&gt;🎯 Целевая аудитория:&lt;/b&gt; Заводы машиностроения и металлообработки (Москва, МО, СПб, ЛО)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e3f2fd;strokeColor=#2196f3;strokeWidth=1.2;fontSize=11;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="465" y="95" width="420" height="36" as="geometry"/></mxCell>
    <mxCell id="5" value="&lt;b&gt;👤 ЛПР:&lt;/b&gt; Главный инженер, нач. производства, нач. склада, директор по закупкам" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=1.2;fontSize=11;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="900" y="95" width="405" height="36" as="geometry"/></mxCell>
    <mxCell id="6" value="&lt;b&gt;📨 Движок:&lt;/b&gt; Яндекс 360 (SMTP + Nodemailer) с антиспам-паузами и персональным стилем" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f3e5f5;strokeColor=#ab47bc;strokeWidth=1.2;fontSize=11;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="1320" y="95" width="400" height="36" as="geometry"/></mxCell>
    <mxCell id="7" value="1. СБОР И ВАЛИДАЦИЯ БАЗЫ" style="swimlane;startSize=35;rounded=1;arcSize=6;fontStyle=1;fontSize=13;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="380" height="1180" as="geometry"/></mxCell>
    <mxCell id="8" value="2. ПОДГОТОВКА И ДВИЖОК (ЯНДЕКС 360)" style="swimlane;startSize=35;rounded=1;arcSize=6;fontStyle=1;fontSize=13;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="440" y="145" width="390" height="1180" as="geometry"/></mxCell>
    <mxCell id="9" value="3. ВОРОНКА И FOLLOW-UP ЦЕПОЧКА" style="swimlane;startSize=35;rounded=1;arcSize=6;fontStyle=1;fontSize=13;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="850" y="145" width="450" height="1180" as="geometry"/></mxCell>
    <mxCell id="10" value="4. ОБРАБОТКА ЛИДОВ, CRM И KPI" style="swimlane;startSize=35;rounded=1;arcSize=6;fontStyle=1;fontSize=13;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="1320" y="145" width="400" height="1180" as="geometry"/></mxCell>
    <mxCell id="11" value="&lt;b&gt;1.1 Источники контактов&lt;/b&gt;&lt;br/&gt;• Реестры машиностроения и металлообработки&lt;br/&gt;• Каталоги производств, сайты заводов (раздел Руководство)&lt;br/&gt;• Профессиональные базы (LinkedIn, HH, 2GIS/Контур)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#1565c0;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="60" y="195" width="340" height="80" as="geometry"/></mxCell>
    <mxCell id="12" value="&lt;b&gt;Ветка А: Платные базы&lt;/b&gt;&lt;br/&gt;• LinkedIn Sales Navigator&lt;br/&gt;• База резюме HH.ru&lt;br/&gt;• Контур.Фокус / СБИС&lt;br/&gt;&lt;span style=&#x27;color:#c62828;&#x27;&gt;✕ Пропущено (нет аккаунтов)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#fafafa;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;fontColor=#616161;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="305" width="165" height="115" as="geometry"/></mxCell>
    <mxCell id="13" value="&lt;b&gt;Ветка Б: Без аккаунтов [ВЫПОЛНЕНО ✅]&lt;/b&gt;&lt;br/&gt;• Каталоги: Заводы.рф, Metaprom&lt;br/&gt;• ЕГРЮЛ (ОКВЭД 25.62, 25.11, 28)&lt;br/&gt;• Скрипт: &lt;i&gt;b2b_crawler_no_auth.py&lt;/i&gt;&lt;br/&gt;• Файлы: &lt;b&gt;.xlsx&lt;/b&gt; / &lt;b&gt;.csv&lt;/b&gt; (15 ЛПР)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="305" width="175" height="115" as="geometry"/></mxCell>
    <mxCell id="14" value="&lt;b&gt;1.2 Структура данных контакта&lt;/b&gt;&lt;br/&gt;• Компания (название завода, тип производства)&lt;br/&gt;• ФИО ЛПР, Точная должность (напр. Главный инженер)&lt;br/&gt;• Корпоративный E-mail, Телефон, Регион (Мск / СПБ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#1565c0;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="340" height="80" as="geometry"/></mxCell>
    <mxCell id="15" value="&lt;b&gt;1.3 Очистка и Валидация [ВЫПОЛНЕНО ✅]&lt;/b&gt;&lt;br/&gt;• Синтаксис RFC 5322: &lt;b&gt;15 из 15 (100% OK)&lt;/b&gt;&lt;br/&gt;• Проверка DNS MX: &lt;b&gt;15 активных серверов (100%)&lt;/b&gt;&lt;br/&gt;• Серверы: Яндекс 360 (5), Заводские Exchange (4), VK (1), Хостинг (5)&lt;br/&gt;• Скрипт: &lt;i&gt;validate_and_segment.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="340" height="95" as="geometry"/></mxCell>
    <mxCell id="16" value="&lt;b&gt;1.4 Сегментация базы [ВЫПОЛНЕНО ✅]&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Сегмент А (Москва и МО)&lt;/b&gt;: 8 заводов (&lt;i&gt;b2b_segment_A_moscow.xlsx&lt;/i&gt;)&lt;br/&gt;• &lt;b&gt;Сегмент B (СПб и ЛО)&lt;/b&gt;: 7 заводов (&lt;i&gt;b2b_segment_B_spb.xlsx&lt;/i&gt;)&lt;br/&gt;• Профили ЛПР: Техническая дирекция (11), Производство (3), Гендир (1)&lt;br/&gt;• Сгенерированы персональные теги: {Обращение}, {Болевая_Точка}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="340" height="95" as="geometry"/></mxCell>
    <mxCell id="17" value="&lt;b&gt;1.5 Готовая выборка для рассылки [ГОТОВО К ОТПРАВКЕ 🚀]&lt;/b&gt;&lt;br/&gt;• Файл: &lt;b&gt;b2b_contacts_validated.xlsx / .csv&lt;/b&gt; (15 проверенных ЛПР)&lt;br/&gt;• Доставляемость: &lt;b&gt;100% Active MX&lt;/b&gt;, риск спам-ловушек: &lt;b&gt;0%&lt;/b&gt;&lt;br/&gt;• Готово к передаче в Шаг 2.1 (Шаблонизация писем)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#bbdefb;strokeColor=#1565c0;fontColor=#0d47a1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="785" width="340" height="85" as="geometry"/></mxCell>
    <mxCell id="18" value="&lt;b&gt;2.1 Персонализация и Шаблоны [ВЫПОЛНЕНО ✅]&lt;/b&gt;&lt;br/&gt;• Авторский шаблон: &lt;b&gt;Денис Юрьевич Пыхтеев (ЧЗ «Механика»)&lt;/b&gt;&lt;br/&gt;• Индивидуальные теги: {Обращение}, {Компания}, {Болевая_Точка}&lt;br/&gt;• Ролик Rutube: &lt;i&gt;rutube.ru/video/9b4e718a...&lt;/i&gt; (1:20 мин)&lt;br/&gt;• Сгенерировано 15 писем: &lt;b&gt;campaign_dataset.json&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="460" y="195" width="350" height="95" as="geometry"/></mxCell>
    <mxCell id="19" value="&lt;b&gt;2.2 Вложения ЧЗМ подключены [ВЫПОЛНЕНО ✅]&lt;/b&gt;&lt;br/&gt;• Вложение 1: &lt;b&gt;Механика Инф.pdf&lt;/b&gt; (209 КБ, презентация завода)&lt;br/&gt;• Вложение 2: &lt;b&gt;КП_ЧЗМ_стеллаж_для_предприятий_с_фото.pdf&lt;/b&gt; (303 КБ)&lt;br/&gt;• Общий вес: &lt;b&gt;~512 КБ&lt;/b&gt; (идеально для корпоративного антиспама)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="460" y="315" width="350" height="85" as="geometry"/></mxCell>
    <mxCell id="20" value="&lt;b&gt;2.3 Движок: Яндекс 360 [ВЫПОЛНЕНО ✅]&lt;/b&gt;&lt;br/&gt;• Отправитель: &lt;b&gt;pdu@mehan59.ru&lt;/b&gt; (SSL порт 465, smtp.ya.ru)&lt;br/&gt;• Скрытая копия (BCC): &lt;b&gt;pdu@mehan59.ru, krantehpto@list.ru&lt;/b&gt;&lt;br/&gt;• Тест на &lt;i&gt;loftglam@gmail.com&lt;/i&gt;: &lt;b&gt;ДОСТАВЛЕНО (250 Ok)&lt;/b&gt;&lt;br/&gt;• Скрипт отправки: &lt;i&gt;send_test_email.js&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="350" height="95" as="geometry"/></mxCell>
    <mxCell id="21" value="&lt;b&gt;2.4 Доставляемость и Антиспам&lt;/b&gt;&lt;br/&gt;• Проверка DKIM, SPF, DMARC корпоративного домена&lt;br/&gt;• Юридический блок, контакты компании и ссылка отписки (152-ФЗ)&lt;br/&gt;• Имитация ручной отправки: отсутствие спам-триггеров" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#6a1b9a;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="460" y="530" width="350" height="80" as="geometry"/></mxCell>
    <mxCell id="22" value="&lt;b&gt;2.5 Очередь и Rate Limiting&lt;/b&gt;&lt;br/&gt;• Рандомизированные паузы: &lt;b&gt;30 – 60 секунд&lt;/b&gt; между письмами&lt;br/&gt;• Суточный лимит: до &lt;b&gt;300 – 500 писем/день&lt;/b&gt; с одного ящика&lt;br/&gt;• Защита от блокировок спам-фильтрами почтовых сервисов" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#6a1b9a;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="460" y="640" width="350" height="80" as="geometry"/></mxCell>
    <mxCell id="23" value="&lt;b&gt;2.6 Логирование и Обработка ошибок&lt;/b&gt;&lt;br/&gt;• Запись Message-ID, статуса, времени доставки&lt;br/&gt;• Автоповтор (Retry) при временных сбоях сети (2×)&lt;br/&gt;• Фиксация Bounce (несуществующих адресов) для очистки базы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#e1bee7;strokeColor=#6a1b9a;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="460" y="750" width="350" height="80" as="geometry"/></mxCell>
    <mxCell id="24" value="&lt;b&gt;Письмо 1 (День 0) — Основное КП&lt;/b&gt;&lt;br/&gt;• Проблема: поиск листов, риск травм, потеря места&lt;br/&gt;• Решение: Стеллаж 16112.200 (5 полок, 25 т, 100% выкат)&lt;br/&gt;• Вложение: PDF КП с фото + запрос данных для расчета" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#ef6c00;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="870" y="195" width="410" height="80" as="geometry"/></mxCell>
    <mxCell id="25" value="Ответил /&lt;br/&gt;Запрос?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="1015" y="295" width="120" height="55" as="geometry"/></mxCell>
    <mxCell id="26" value="&lt;b&gt;Письмо 2 (День 3–5) — Экономия площади&lt;/b&gt;&lt;br/&gt;• Напоминание о письме 1 в той же цепочке (Re: ...)&lt;br/&gt;• Акцент: высвобождение до 70% полезной площади цеха&lt;br/&gt;• Быстрый доступ к любому листу за 45 секунд" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#ef6c00;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="870" y="385" width="410" height="75" as="geometry"/></mxCell>
    <mxCell id="27" value="Ответил?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="1020" y="480" width="110" height="50" as="geometry"/></mxCell>
    <mxCell id="28" value="&lt;b&gt;Письмо 3 (День 7–10) — Кейс и Надежность&lt;/b&gt;&lt;br/&gt;• Пример внедрения на производстве сходного профиля&lt;br/&gt;• Надежность привода и расчет под лист 6000×2000 мм&lt;br/&gt;• Сокращение работы кран-балки и ручного труда" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#ef6c00;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="870" y="560" width="410" height="75" as="geometry"/></mxCell>
    <mxCell id="29" value="Ответил?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="1020" y="655" width="110" height="50" as="geometry"/></mxCell>
    <mxCell id="30" value="&lt;b&gt;Письмо 4 (День 14) — Демонстрация / Звонок&lt;/b&gt;&lt;br/&gt;• Предложение короткого 10-мин созвона или видео работы&lt;br/&gt;• Ссылка на демонстрацию выдвижения платформы под нагрузкой&lt;br/&gt;• Консультация с техническим специалистом ЧЗМ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#ef6c00;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="870" y="735" width="410" height="75" as="geometry"/></mxCell>
    <mxCell id="31" value="Ответил?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="1020" y="830" width="110" height="50" as="geometry"/></mxCell>
    <mxCell id="32" value="&lt;b&gt;Письмо 5 (День 21) — Финальное письмо&lt;/b&gt;&lt;br/&gt;• Уведомление о завершении текущей серии контактов&lt;br/&gt;• Бронь производственного слота ЧЗМ на изготовление&lt;br/&gt;• Контакты для связи при появлении потребности в будущем" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#ef6c00;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="870" y="910" width="410" height="75" as="geometry"/></mxCell>
    <mxCell id="33" value="Ответил?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="1020" y="1005" width="110" height="50" as="geometry"/></mxCell>
    <mxCell id="34" value="&lt;b&gt;Архив / Реактивация базы&lt;/b&gt;&lt;br/&gt;• Перенос контакта в холодный архив&lt;br/&gt;• Повторное касание через 4–6 месяцев при обновлении каталога" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="870" y="1085" width="410" height="55" as="geometry"/></mxCell>
    <mxCell id="35" value="&lt;b&gt;4.1 Квалификация лида: Сбор данных&lt;/b&gt;&lt;br/&gt;Получение параметров для точного ТКП:&lt;br/&gt;• Размеры листа и максимальная масса пачки (до 5 т)&lt;br/&gt;• Требуемый объем хранения (кол-во ярусов)&lt;br/&gt;• Габариты зоны склада / высота цеха&lt;br/&gt;• Сведения о кран-балке и электропитании (380В)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1340" y="195" width="360" height="105" as="geometry"/></mxCell>
    <mxCell id="36" value="&lt;b&gt;4.2 Фиксация сделки в CRM&lt;/b&gt;&lt;br/&gt;• Автосоздание сделки (Битрикс24 / amoCRM)&lt;br/&gt;• Прикрепление истории переписки из Яндекс 360&lt;br/&gt;• Назначение ответственного инженера-сметчика ЧЗМ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1340" y="330" width="360" height="75" as="geometry"/></mxCell>
    <mxCell id="37" value="&lt;b&gt;4.3 Расчет стоимости и ТКП&lt;/b&gt;&lt;br/&gt;• Индивидуальная адаптация стеллажа 16112.200&lt;br/&gt;• Расчет цены, сроков изготовления и доставки (РФ)&lt;br/&gt;• Выход на подписание договора поставки" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#c8e6c9;strokeColor=#2e7d32;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="1340" y="435" width="360" height="75" as="geometry"/></mxCell>
    <mxCell id="38" value="&lt;b&gt;4.4 Контроль целевых метрик (KPI)&lt;/b&gt;&lt;br/&gt;&lt;table style=&#x27;width:100%;font-size:11px;border-collapse:collapse;margin-top:4px;&#x27;&gt;&lt;tr style=&#x27;border-bottom:1px solid #c8e6c9;&#x27;&gt;&lt;td&gt;&lt;b&gt;Метрика&lt;/b&gt;&lt;/td&gt;&lt;td align=&#x27;right&#x27;&gt;&lt;b&gt;Цель ТЗ&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Доставляемость&lt;/td&gt;&lt;td align=&#x27;right&#x27;&gt;&lt;b&gt;≥ 95%&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Открытия (Open Rate)&lt;/td&gt;&lt;td align=&#x27;right&#x27;&gt;&lt;b&gt;≥ 20%&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Клики по ссылкам&lt;/td&gt;&lt;td align=&#x27;right&#x27;&gt;&lt;b&gt;≥ 3%&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ответы (Reply Rate)&lt;/td&gt;&lt;td align=&#x27;right&#x27;&gt;&lt;b&gt;≥ 1%&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Запрос расчета (Лид)&lt;/td&gt;&lt;td align=&#x27;right&#x27;&gt;&lt;b&gt;≥ 0.5%&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Отписки&lt;/td&gt;&lt;td align=&#x27;right&#x27;&gt;&lt;b&gt;≤ 0.5%&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1340" y="540" width="360" height="175" as="geometry"/></mxCell>
    <mxCell id="39" value="&lt;b&gt;4.5 Сквозная отчетность и A/B тесты&lt;/b&gt;&lt;br/&gt;• Экспорт статистики отправки в Excel / Google Sheets&lt;br/&gt;• A/B тестирование заголовков и аргументов&lt;br/&gt;• Корректировка базы и сегментов по итогам отклика" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=11;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1340" y="745" width="360" height="85" as="geometry"/></mxCell>
